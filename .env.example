# Reown / WalletConnect project id (EVM wallets) - https://cloud.reown.com
VITE_PROJECT_ID=

# Stellar network: TESTNET (default) or PUBLIC
VITE_STELLAR_NETWORK=TESTNET
# Optional overrides (defaults match the network above)
# VITE_STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
# VITE_STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# STONE reward asset + Soroban contracts (see stoneale-games/stoneale-contracts)
VITE_STONE_ASSET_ISSUER=
VITE_STONE_REWARDS_CONTRACT_ID=
VITE_WELLNESS_BADGES_CONTRACT_ID=
